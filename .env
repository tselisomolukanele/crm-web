# OAuth2 Configuration
# Copy this file to .env and fill in your OAuth2 server details

EXPO_PUBLIC_OAUTH_AUTHORIZATION_ENDPOINT=http://localhost:8000/authorize
EXPO_PUBLIC_OAUTH_TOKEN_ENDPOINT=http://localhost:8000/access_token
EXPO_PUBLIC_OAUTH_CLIENT_ID=THE_CLIENT_ID
EXPO_PUBLIC_OAUTH_CLIENT_SECRET=abc123

# Note: Client secret is optional and depends on your OAuth2 server configuration
# Some servers require it for confidential clients, others use PKCE only
