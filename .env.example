# OAuth2 Configuration
# Copy this file to .env and fill in your OAuth2 server details

EXPO_PUBLIC_OAUTH_AUTHORIZATION_ENDPOINT=https://your-oauth-server.com/oauth/authorize
EXPO_PUBLIC_OAUTH_TOKEN_ENDPOINT=https://your-oauth-server.com/oauth/token
EXPO_PUBLIC_OAUTH_CLIENT_ID=your-client-id
EXPO_PUBLIC_OAUTH_CLIENT_SECRET=your-client-secret

# Note: Client secret is optional and depends on your OAuth2 server configuration
# Some servers require it for confidential clients, others use PKCE only
